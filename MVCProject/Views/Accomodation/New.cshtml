@model MVCProject.ViewModels.AccomodationViewModels.AddAcccomodationVM

@{
    ViewData["Title"] = "Add New Accommodation";
}

<style>
    .text-primary-custom { color: #28b5a4 !important; }
    .bg-primary-custom { background-color: #28b5a4 !important; color: white; }
    .btn-primary-custom { background-color: #28b5a4; border-color: #28b5a4; color: white; }
    .btn-primary-custom:hover { background-color: #219688; border-color: #219688; color: white; }
    .btn-outline-secondary-custom { color: #6c757d; border-color: #6c757d; }
    .btn-outline-secondary-custom:hover { background-color: #6c757d; color: white; }
    .form-control:focus { border-color: #28b5a4; box-shadow: 0 0 0 0.25rem rgba(40, 181, 164, 0.25); }
    .card-custom { border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.08); border-radius: 10px; }
</style>

<div class="row justify-content-center mt-5">
    <div class="col-lg-8 col-md-10">
        <div class="card card-custom p-4">
            <h2 class="text-primary-custom fw-bold border-bottom pb-3 mb-4">
                🏠 Add New Accommodation
            </h2>

            <form asp-action="New" method="post" enctype="multipart/form-data">
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label fw-bold text-muted"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g., Sea View Resort" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label fw-bold text-muted"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g., Alexandria, Egypt" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PricePerNight" class="form-label fw-bold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">$</span>
                            <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="PricePerNight" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AvailableRooms" class="form-label fw-bold text-muted"></label>
                        <input asp-for="AvailableRooms" class="form-control" type="number" placeholder="Number of available rooms" />
                        <span asp-validation-for="AvailableRooms" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageFile" class="form-label fw-bold text-muted">Accommodation Image</label>
                    <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                    <div class="form-text">Accepted formats: .jpg, .png, .jpeg</div>
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="SellerAccomodations" class="btn btn-outline-secondary-custom px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom px-4 fw-bold">Save Accommodation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}