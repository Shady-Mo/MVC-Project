@model IEnumerable<MVCProject.ViewModels.AccomodationViewModels.DisplayAccomodationVM>

@{
    ViewData["Title"] = "Accommodations";
    
    var currentSearch = Context.Request.Query["searchQuery"].FirstOrDefault() ?? "";
    var currentMaxPrice = Context.Request.Query["maxPrice"].FirstOrDefault() ?? "5000";
    var currentMinCapacity = Context.Request.Query["minCapacity"].FirstOrDefault() ?? "1";
}

<style>
    .text-primary-custom { color: #28b5a4 !important; }
    .bg-primary-custom { background-color: #28b5a4 !important; color: white; }
    
    .btn-primary-custom { background-color: #28b5a4; border-color: #28b5a4; color: white; transition: all 0.3s; }
    .btn-primary-custom:hover { background-color: #219688; border-color: #219688; color: white; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(40,181,164,0.3); }
    .btn-outline-primary-custom { color: #28b5a4; border-color: #28b5a4; transition: all 0.3s; }
    .btn-outline-primary-custom:hover { background-color: #28b5a4; color: white; transform: translateY(-2px); }
    
    .filter-sidebar { 
        background: rgba(248, 249, 250, 0.85); 
        backdrop-filter: blur(10px);
        padding: 25px; 
        border-radius: 15px; 
        border: 1px solid rgba(255,255,255,0.5);
        box-shadow: 0 10px 30px rgba(0,0,0,0.05); 
    }
    
    .activity-card { 
        border-radius: 15px; 
        border: none; 
        transition: all 0.3s ease; 
        background: #fff;
    }
    .activity-card:hover { 
        transform: translateY(-8px); 
        box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important; 
    }
    .card-img-top { 
        height: 220px; 
        object-fit: cover; 
        border-top-left-radius: 15px; 
        border-top-right-radius: 15px; 
    }
    
    .form-range::-webkit-slider-thumb { background-color: #28b5a4; }
    .form-range::-webkit-slider-thumb:active { background-color: #219688; }
</style>

<div class="container mt-4 mb-5">
    
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="text-primary-custom m-0 fw-bold d-flex align-items-center">
                <span class="fs-2 me-2">🏨</span> Accommodations
            </h1>
        </div>
        <div class="col text-end">
            @if (User.IsInRole("Seller"))
            {
                <a asp-action="New" class="btn btn-primary-custom fw-bold px-4 rounded-pill shadow-sm">
                    + New Accommodation
                </a>
            }

            @if (User.IsInRole("Seller"))
            {
                <a asp-action="SellerAccomodations" class="btn btn-primary-custom fw-bold px-4 rounded-pill shadow-sm">
                    My Accomodations
                </a>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="filter-sidebar sticky-top" style="top: 90px;">
                <h5 class="mb-4 text-dark fw-bold d-flex align-items-center">
                    <span class="me-2">🎯</span> Filters
                </h5>
                <form asp-action="Index" method="get">
                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold small text-uppercase">Search</label>
                        <div class="input-group shadow-sm rounded">
                            <span class="input-group-text bg-white border-end-0">🔍</span>
                            <input type="text" name="searchQuery" class="form-control border-start-0 ps-0" placeholder="Name or location..." value="@currentSearch" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="priceRange" class="form-label text-muted fw-bold small text-uppercase d-flex justify-content-between w-100">
                            <span>Max Price</span>
                            <span class="badge bg-primary-custom text-white fs-6 shadow-sm" id="priceOutput">$@currentMaxPrice</span>
                        </label>
                        <input type="range" class="form-range custom-range mt-2" min="50" max="5000" step="50" id="priceRange" name="maxPrice" value="@currentMaxPrice" oninput="document.getElementById('priceOutput').innerText = '$' + this.value">
                    </div>

                    <div class="mb-5">
                        <label for="capacityRange" class="form-label text-muted fw-bold small text-uppercase d-flex justify-content-between w-100">
                            <span>Min Rooms</span>
                            <span class="badge bg-light text-dark border fs-6 shadow-sm" id="capacityOutput">@currentMinCapacity</span>
                        </label>
                        <input type="range" class="form-range custom-range mt-2" min="1" max="50" step="1" id="capacityRange" name="minCapacity" value="@currentMinCapacity" oninput="document.getElementById('capacityOutput').innerText = this.value">
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary-custom fw-bold shadow-sm" type="submit">Apply Filters</button>
                        <a asp-action="Index" class="btn btn-light border fw-bold text-secondary shadow-sm">Clear Filters</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-9 col-md-8">
            @if (!Model.Any())
            {
                <div class="text-center p-5 bg-white rounded-3 shadow-sm border mt-2">
                    <div style="font-size: 5rem; margin-bottom: 15px; opacity: 0.7;">?????</div>
                    <h4 class="fw-bold text-dark">No accommodations found</h4>
                    <p class="text-muted">Try adjusting your filters or search query to find what you're looking for.</p>
                    <a asp-action="Index" class="btn btn-outline-primary-custom mt-3 fw-bold px-4">Clear All Filters</a>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                    @foreach (var item in Model) {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 activity-card">
                                
                                <div class="position-relative">
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="~/images/@item.Image" class="card-img-top" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="bg-light card-img-top d-flex align-items-center justify-content-center text-secondary" style="font-size: 4rem;">
                                            ???
                                        </div>
                                    }
                                    <div class="position-absolute top-0 end-0 m-3 badge bg-white text-primary-custom shadow-sm fs-6 px-3 py-2 rounded-pill">
                                        @item.PricePerNight.ToString("C") <span class="small text-muted fw-normal">/ nt</span>
                                    </div>
                                </div>

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-dark fw-bold mb-2">@item.Name</h5>
                                    <p class="card-text text-muted mb-3 small d-flex align-items-center">
                                        <span class="me-1">📍</span> @item.Location
                                    </p>

                                    <div class="mt-auto">
                                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill mb-3 w-100 text-start d-flex align-items-center">
                                            <span class="me-2 fs-6">🚪</span> @item.AvailableRooms Available Rooms
                                        </span>
                                    </div>

                                     <div class="mt-auto">
                                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill mb-3 w-100 text-start d-flex align-items-center">
                                           Seller Name : @item.SellerName
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="card-footer bg-transparent border-top-0 pt-0 pb-4 px-4">
                                    <div class="btn-group w-100 shadow-sm rounded" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary-custom fw-bold">Details</a>
                                        @if (User.IsInRole("Seller"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary fw-bold">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger fw-bold">Delete</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-5 pb-4 d-flex justify-content-center align-items-md-center gap-5">
                        <ul class="pagination justify-content-center d-inline-flex flex-wrap gap-2" style="background: transparent; box-shadow: none;">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link text-primary-custom" style="border-radius: 8px; font-weight: 500; border: 1px solid #dee2e6; color: #333;" href="?pageNumber=@(ViewBag.CurrentPage - 1)&searchQuery=@currentSearch&maxPrice=@currentMaxPrice&minCapacity=@currentMinCapacity">Previous</a>
                                </li>
                            }

                            @{
                                int maxPagesToShow = 10;
                                int startPage = Math.Max(1, ViewBag.CurrentPage - (maxPagesToShow / 2));
                                int endPage = Math.Min(ViewBag.TotalPages, startPage + maxPagesToShow - 1);

                                if (endPage - startPage + 1 < maxPagesToShow)
                                {
                                    startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                }
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link text-primary-custom" style="border-radius: 8px; font-weight: 500; border: 1px solid #dee2e6; color: #333;" href="?pageNumber=1&searchQuery=@currentSearch&maxPrice=@currentMaxPrice&minCapacity=@currentMinCapacity">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link" style="border-radius: 8px; background: transparent; border: none;">...</span></li>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                    <a class="page-link @(ViewBag.CurrentPage == i ? "bg-primary-custom text-white" : "text-primary-custom")" 
                                       style="border-radius: 8px; font-weight: 500; border: 1px solid #dee2e6; @(ViewBag.CurrentPage != i ? "color: #333;" : "")" 
                                       href="?pageNumber=@i&searchQuery=@currentSearch&maxPrice=@currentMaxPrice&minCapacity=@currentMinCapacity">@i</a>
                                </li>
                            }

                            @if (endPage < ViewBag.TotalPages)
                            {
                                @if (endPage < ViewBag.TotalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link" style="border-radius: 8px; background: transparent; border: none;">...</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link text-primary-custom" style="border-radius: 8px; font-weight: 500; border: 1px solid #dee2e6; color: #333;" href="?pageNumber=@ViewBag.TotalPages&searchQuery=@currentSearch&maxPrice=@currentMaxPrice&minCapacity=@currentMinCapacity">@ViewBag.TotalPages</a>
                                </li>
                            }

                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link text-primary-custom" style="border-radius: 8px; font-weight: 500; border: 1px solid #dee2e6; color: #333;" href="?pageNumber=@(ViewBag.CurrentPage + 1)&searchQuery=@currentSearch&maxPrice=@currentMaxPrice&minCapacity=@currentMinCapacity">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>