@model MVCProject.ViewModels.AccomodationViewModels.DisplayAccomodationVM

@{
    ViewData["Title"] = "Confirm Deletion";
}

<style>
    .text-primary-custom { color: #28b5a4 !important; }
    .bg-danger-custom { background-color: #dc3545 !important; color: white; }
    .btn-outline-secondary-custom { color: #6c757d; border-color: #6c757d; }
    .btn-outline-secondary-custom:hover { background-color: #6c757d; color: white; }
    .card-custom { border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.08); border-radius: 10px; overflow: hidden; }
    .details-img { width: 100%; height: 100%; max-height: 300px; object-fit: cover; border-radius: 8px; }
    .info-label { font-weight: bold; color: #6c757d; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; }
    .info-value { font-size: 1.1rem; color: #333; font-weight: 500; }
</style>

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-lg-8">
        
        <div class="alert alert-danger shadow-sm d-flex align-items-center mb-4" role="alert">
            <span class="fs-4 me-3">⚠️</span>
            <div>
                <h4 class="alert-heading fw-bold mb-1">Are you absolutely sure?</h4>
                <p class="mb-0">You are about to delete <strong>@Model.Name</strong>. This action cannot be undone, and the associated image will also be permanently removed.</p>
            </div>
        </div>

        <div class="card card-custom p-4 mb-4">
            <div class="row align-items-center">
                <div class="col-md-4 mb-3 mb-md-0">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="~/images/@Model.Image" class="details-img shadow-sm" alt="@Model.Name" />
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center justify-content-center w-100" style="height: 200px; font-size: 4rem;">
                            🛏️
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <h3 class="text-dark fw-bold mb-3 border-bottom pb-2">@Model.Name</h3>
                    
                    <div class="row">
                        <div class="col-6 mb-3">
                            <div class="info-label">📍 Location</div>
                            <div class="info-value">@Model.Location</div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="info-label">💲 Price Per Night</div>
                            <div class="info-value text-danger fw-bold">@Model.PricePerNight.ToString("C")</div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="info-label">🚪 Available Rooms</div>
                            <div class="info-value">@Model.AvailableRooms Rooms</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-2">
           <a asp-action="SellerAccomodations" class="btn btn-outline-secondary-custom px-4">Cancel</a>

            
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                    Yes, Delete Accommodation
                </button>
            </form>
        </div>
        
    </div>
</div>