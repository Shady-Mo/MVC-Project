@model MVCProject.ViewModels.ProfileViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-6">
        <div class="card shadow border-0" style="border-radius: 15px;">
            <div class="card-header text-white text-center" style="background: linear-gradient(135deg, #3ac0ad 0%, #f4b266 100%); border-top-left-radius: 15px; border-top-right-radius: 15px;">
                <h4 style="margin: 0; padding: 10px 0;"><i class="fas fa-user-circle"></i> User Profile</h4>
            </div>
            <div class="card-body p-5">
                <div class="mb-4 pb-2" style="border-bottom: 2px dashed rgba(58,192,173,0.3);">
                    <strong class="text-muted d-block mb-1" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;"><i class="fas fa-user" style="color: #3ac0ad; width: 20px;"></i> Full Name</strong>
                    <div class="fs-4 fw-bold" style="color: #333;">@Model.FullName</div>
                </div>
                <div class="mb-4 pb-2" style="border-bottom: 2px dashed rgba(58,192,173,0.3);">
                    <strong class="text-muted d-block mb-1" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;"><i class="fas fa-envelope" style="color: #3ac0ad; width: 20px;"></i> Email</strong>
                    <div class="fs-5" style="color: #555;">@Model.Email</div>
                </div>
                <div class="mb-4 pb-2" style="border-bottom: 2px dashed rgba(58,192,173,0.3);">
                    <strong class="text-muted d-block mb-1" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;"><i class="fas fa-map-marker-alt" style="color: #3ac0ad; width: 20px;"></i> Address</strong>
                    <div class="fs-5" style="color: #555;">@(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)</div>
                </div>
                <div class="mb-5">
                    <strong class="text-muted d-block mb-1" style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;"><i class="fas fa-phone" style="color: #3ac0ad; width: 20px;"></i> Phone Number</strong>
                    <div class="fs-5" style="color: #555;">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)</div>
                </div>

                <div class="text-center">
                    <a asp-action="UpdateProfile" class="btn px-5 py-3 text-white fw-bold shadow-sm" style="background: #3ac0ad; border-radius: 30px; transition: all 0.3s ease; text-decoration: none;" onmouseover="this.style.background='#31a393'; this.style.transform='translateY(-2px)';" onmouseout="this.style.background='#3ac0ad'; this.style.transform='translateY(0)';">
                        <i class="fas fa-edit me-2"></i>Edit Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
