@model MVCProject.ViewModels.ProfileViewModels.UpdateProfileViewModel
@{
    ViewData["Title"] = "Update Profile";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-6">
        <div class="card shadow border-0" style="border-radius: 15px;">
            <div class="card-header text-white text-center" style="background: linear-gradient(135deg, #3ac0ad 0%, #f4b266 100%); border-top-left-radius: 15px; border-top-right-radius: 15px;">
                <h4 style="margin: 0; padding: 10px 0;"><i class="fas fa-user-edit"></i> Update Profile</h4>
            </div>
            <div class="card-body p-5">
                <form asp-action="UpdateProfile" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="FullName" class="form-control" id="floatingFullName" placeholder="Full Name" style="border-radius: 10px; border: 1px solid rgba(58,192,173,0.3);" />
                        <label asp-for="FullName" for="floatingFullName" style="color: #666;"><i class="fas fa-user me-2" style="color: #3ac0ad;"></i>Full Name</label>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Address" class="form-control" id="floatingAddress" placeholder="Address" style="border-radius: 10px; border: 1px solid rgba(58,192,173,0.3);" />
                        <label asp-for="Address" for="floatingAddress" style="color: #666;"><i class="fas fa-map-marker-alt me-2" style="color: #3ac0ad;"></i>Address</label>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-5">
                        <input asp-for="PhoneNumber" class="form-control" id="floatingPhone" placeholder="Phone Number" style="border-radius: 10px; border: 1px solid rgba(58,192,173,0.3);" />
                        <label asp-for="PhoneNumber" for="floatingPhone" style="color: #666;"><i class="fas fa-phone me-2" style="color: #3ac0ad;"></i>Phone Number</label>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-lg text-white shadow-sm" style="background: #3ac0ad; border-radius: 30px; font-weight: 600; padding: 12px 20px; transition: all 0.3s ease;" onmouseover="this.style.background='#31a393'; this.style.transform='translateY(-2px)';" onmouseout="this.style.background='#3ac0ad'; this.style.transform='translateY(0)';">Save Changes</button>
                        <a asp-action="Index" class="btn btn-lg shadow-sm" style="background: white; border: 2px solid #eee; color: #666; border-radius: 30px; font-weight: 600; padding: 12px 20px; transition: all 0.3s ease;" onmouseover="this.style.borderColor='#6c757d'; this.style.color='#333'; this.style.transform='translateY(-2px)';" onmouseout="this.style.borderColor='#eee'; this.style.color='#666'; this.style.transform='translateY(0)';">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
