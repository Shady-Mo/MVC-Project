@model MVCProject.ViewModels.BookingViewModel.DisplayBookingVM

@{
    ViewData["Title"] = "Cancel Booking";
}

<style>
    .text-primary-custom { color: #28b5a4 !important; }
    .card-custom { border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.08); border-radius: 10px; overflow: hidden; }
    .info-label { font-weight: bold; color: #6c757d; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; }
    .info-value { font-size: 1.1rem; color: #333; font-weight: 500; }
</style>

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-lg-8">
        
        <div class="alert alert-danger shadow-sm d-flex align-items-center mb-4" role="alert">
            <span class="fs-4 me-3">⚠️</span>
            <div>
                <h4 class="alert-heading fw-bold mb-1">Cancel this booking?</h4>
                <p class="mb-0">You are about to delete the booking for <strong>@Model.Country</strong>. This action cannot be undone, and all reserved spots for flights, hotels, and activities will be released back to the system.</p>
            </div>
        </div>

        <div class="card card-custom p-4 mb-4">
            <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                <h3 class="text-dark fw-bold m-0">Trip to @Model.Country</h3>
                <span class="text-muted fw-bold">#@Model.Id</span>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="info-label">📅 Date</div>
                    <div class="info-value">@Model.BookingDate.ToString("MMMM dd, yyyy")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="info-label">💲 Total Amount</div>
                    <div class="info-value text-danger fw-bold fs-5">@Model.TotalAmount.ToString("C")</div>
                </div>
                
                <div class="col-12 mt-2">
                    <div class="info-label">Items Reserved</div>
                    <div class="d-flex gap-2 mt-1">
                        <span class="badge bg-light text-dark border p-2">✈️ @Model.FlightsCount Flights</span>
                        <span class="badge bg-light text-dark border p-2">🏨 @Model.AccommodationsCount Hotels</span>
                        <span class="badge bg-light text-dark border p-2">🎯 @Model.ActivitiesCount Activities</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold">Keep Booking</a>
            
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                    Yes, Cancel Booking
                </button>
            </form>
        </div>
        
    </div>
</div>