@model IEnumerable<MVCProject.ViewModels.BookingViewModel.DisplayBookingVM>

@{
    ViewData["Title"] = "All Bookings";
}

<style>
    .text-primary-custom { color: #28b5a4 !important; }
    .bg-primary-custom { background-color: #28b5a4 !important; color: white; }
    .border-primary-custom { border-color: #28b5a4 !important; }
    .btn-primary-custom { background-color: #28b5a4; border-color: #28b5a4; color: white; }
    .btn-primary-custom:hover { background-color: #219688; border-color: #219688; color: white; }
    .btn-outline-primary-custom { color: #28b5a4; border-color: #28b5a4; }
    .btn-outline-primary-custom:hover { background-color: #28b5a4; border-color: #28b5a4; color: white; }
    
    .table-custom { background-color: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .table-custom thead { background-color: #f8f9fa; color: #6c757d; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.85rem; }
    .table-custom th, .table-custom td { vertical-align: middle; padding: 1rem; border-bottom: 1px solid #f0f0f0; }
    .status-badge { font-weight: 600; padding: 0.4em 0.8em; border-radius: 6px; }
</style>

<div class="container mt-4 mb-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary-custom fw-bold m-0">
            🧳 All Bookings
        </h2>
    </div>

    <div class="card border-0 shadow-sm rounded-3 p-3 mb-4">
        <form asp-action="Index" method="get">
            <div class="row align-items-center">
                <div class="col-md-6 col-lg-5">
                    <div class="input-group shadow-sm">
                        <span class="input-group-text bg-white border-end-0">🔍</span>
                        <input type="text" name="searchQuery" class="form-control border-start-0 ps-0" placeholder="Search by Country or User Name..." value="@Context.Request.Query["searchQuery"]" />
                        <button class="btn btn-primary-custom px-4 fw-bold" type="submit">Search</button>
                        @if (!string.IsNullOrEmpty(Context.Request.Query["searchQuery"]))
                        {
                            <a asp-action="Index" class="btn btn-light border text-danger">Clear</a>
                        }
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <div style="font-size: 4rem; margin-bottom: 10px;">🏝️</div>
                <h4 class="fw-bold">No bookings found</h4>
                <p>We couldn't find any bookings matching your criteria.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-custom table-hover mb-0">
                    <thead>
                        <tr>
                            <th># ID</th>
                            <th>User ID</th>
                            <th>Destination</th>
                            <th>Date</th>
                            <th>Included</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted fw-bold">#@item.Id</td>
                                
                                <td>
                                    <div class="text-muted small" style="max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@item.UserId">
                                        👤 @item.UserId
                                    </div>
                                </td>
                                
                                <td>
                                    <div class="fw-bold text-dark">@item.Country</div>
                                </td>
                                
                                <td>
                                    <div class="text-muted">📅 @item.BookingDate.ToString("MMM dd, yyyy")</div>
                                </td>
                                
                                <td>
                                    <div class="d-flex gap-2">
                                        @if(item.AccommodationsCount > 0) { <span class="badge bg-light text-dark border" title="Hotels">🏨 @item.AccommodationsCount</span> }
                                        @if(item.ActivitiesCount > 0) { <span class="badge bg-light text-dark border" title="Activities">🎯 @item.ActivitiesCount</span> }
                                    </div>
                                </td>
                                
                                <td>
                                    <div class="fw-bold text-primary-custom fs-5">@item.TotalAmount.ToString("C")</div>
                                </td>
                                
                                <td>
                                    @{
                                        var badgeClass = item.Status switch
                                        {
                                            "Confirmed" => "bg-success text-white",
                                            "Pending" => "bg-warning text-dark",
                                            "Cancelled" => "bg-danger text-white",
                                            _ => "bg-secondary text-white"
                                        };
                                    }
                                    <span class="badge status-badge @badgeClass">
                                        @item.Status
                                    </span>
                                </td>
                                
                                <td class="text-end">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary-custom fw-bold">
                                            Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary fw-bold">
                                            Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger fw-bold">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @if (ViewBag.TotalPages > 1)
            {
                <div class="card-footer bg-white border-top-0 py-4">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center m-0">
                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link text-primary-custom" href="?pageNumber=@(ViewBag.CurrentPage - 1)&searchQuery=@Context.Request.Query["searchQuery"]" tabindex="-1">Previous</a>
                            </li>
                            
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                    <a class="page-link @(ViewBag.CurrentPage == i ? "bg-primary-custom border-primary-custom text-white" : "text-primary-custom")" 
                                       href="?pageNumber=@i&searchQuery=@Context.Request.Query["searchQuery"]">@i</a>
                                </li>
                            }
                            
                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link text-primary-custom" href="?pageNumber=@(ViewBag.CurrentPage + 1)&searchQuery=@Context.Request.Query["searchQuery"]">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>