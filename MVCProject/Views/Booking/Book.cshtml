@model MVCProject.ViewModels.BookingViewModel.AddBookingVM

@{
    ViewData["Title"] = "Create Booking";
}

<style>
    .text-primary-custom { color: #28b5a4 !important; }
    .bg-primary-custom { background-color: #28b5a4 !important; color: white; }
    .btn-primary-custom { background-color: #28b5a4; border-color: #28b5a4; color: white; }
    .btn-primary-custom:hover { background-color: #219688; border-color: #219688; color: white; }
    
    .selectable-card { cursor: pointer; transition: all 0.2s ease-in-out; border: 2px solid transparent; height: 100%; }
    .selectable-card:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15); }
    
    /* التعديل: دعم الـ radio */
    input[type="checkbox"].item-selector:checked + .card-content,
    input[type="radio"].item-selector:checked + .card-content {
        border-color: #28b5a4; background-color: #f0fbf9;
    }
    .card-content { border: 2px solid transparent; border-radius: 0.375rem; height: 100%; }
    .hidden-checkbox, .hidden-radio { display: none; }
    
    .hotel-dates { display: none; margin-top: 15px; padding-top: 10px; border-top: 1px dashed #ccc; }
</style>

<div class="container mt-4 mb-5">
    <h2 class="text-primary-custom fw-bold border-bottom pb-3 mb-4">
        🌍 Plan Your Trip
    </h2>

    <form asp-action="Book" method="post" id="bookingForm">
        
        <div class="card shadow-sm border-0 mb-4 p-4">
            <h5 class="fw-bold text-muted mb-3">1. Where are you traveling?</h5>
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">🛫 From (Source)</label>
                    <input type="text" id="sourceCountry" class="form-control" placeholder="e.g. Egypt" required />
                </div>
                
                <div class="col-md-4">
                    <label asp-for="Country" class="form-label fw-bold">🛬 To (Destination)</label>
                    <input asp-for="Country" id="destCountry" class="form-control" placeholder="e.g. France" required />
                    <span asp-validation-for="Country" class="text-danger small"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="BookingDate" class="form-label fw-bold">📅 Flight Date</label>
                    <input asp-for="BookingDate" type="date" class="form-control" required />
                </div>

                <div class="col-md-2 d-grid">
                    <button type="button" id="btnSearch" class="btn btn-dark fw-bold">
                        🔍 Find Options
                    </button>
                </div>
            </div>
        </div>

        <div id="resultsSection" style="display: none;">
            
            <h5 class="fw-bold text-primary-custom mt-4 mb-3">✈️ Select Flight (Choose one)</h5>
            <div class="row g-3" id="flightsContainer"></div>

            <h5 class="fw-bold text-primary-custom mt-5 mb-3">🏨 Select Accommodations</h5>
            <p class="text-muted small mb-3">Check the box to select a hotel, then choose your Check-in and Check-out dates.</p>
            <div class="row g-3" id="hotelsContainer"></div>

            <h5 class="fw-bold text-primary-custom mt-5 mb-3">🏄 Select Activities</h5>
            <div class="row g-3" id="activitiesContainer"></div>

            <div class="text-end mt-5 pt-3 border-top">
                <button type="submit" class="btn btn-primary-custom btn-lg px-5 fw-bold shadow">
                    ✅ Confirm Booking
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            
            $("#btnSearch").click(function () {
                var source = $("#sourceCountry").val();
                var dest = $("#destCountry").val(); 
                var bookingDate = $("#BookingDate").val();

                if (!source || !dest || !bookingDate) {
                    alert("Please enter Source, Destination, and Booking Date!");
                    return;
                }

                var btn = $(this);
                btn.html("⏳ Searching...").prop("disabled", true);

                $.ajax({
                    url: '@Url.Action("GetTravelData", "Booking")',
                    type: 'GET',
                    data: { source: source, dest: dest, date: bookingDate }, 
                    success: function (data) {
                        renderFlights(data.flights);
                        renderHotels(data.hotels);
                        renderActivities(data.activities);
            
                        $("#resultsSection").fadeIn();
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr.responseText);
                        alert("Error loading data. Please try again.");
                    },
                    complete: function () {
                        btn.html("🔍 Find Options").prop("disabled", false);
                    }
                });
            });

            // التعديل: استخدام radio بدل checkbox
            function renderFlights(flights) {
                var html = '';
                if(!flights || flights.length === 0) {
                    html = '<div class="col-12 text-muted">No flights found.</div>';
                } else {
                    flights.forEach(function(f) {
                        html += `
                            <div class="col-md-4">
                                <label class="w-100 selectable-card">
                                    <input type="radio" name="FlightId" value="${f.id}" class="hidden-radio item-selector" required />
                                    <div class="card-content p-3 shadow-sm card flight-card">
                                        <div class="fw-bold text-dark">${f.airline || 'Flight'} - ${f.flightNumber || ''}</div>
                                        <div class="text-muted small">From: ${f.departureCountry || f.departureAirport || ''} ➡️ To: ${f.arrivalCountry || f.destinationAirport || ''}</div>
                                        <div class="text-primary-custom fw-bold mt-2">$${f.price || 0}</div>
                                    </div>
                                </label>
                            </div>
                        `;
                    });
                }
                $("#flightsContainer").html(html);

                // JQuery عشان ينضف الإطارات لما اليوزر يغير رأيه في الطيارة
                $(document).on('change', 'input[name="FlightId"]', function() {
                    $('.flight-card').css({'border-color': 'transparent', 'background-color': 'white'});
                    if(this.checked) {
                        $(this).siblings('.flight-card').css({'border-color': '#28b5a4', 'background-color': '#f0fbf9'});
                    }
                });
            }

            function renderHotels(hotels) {
                var html = '';
                if(!hotels || hotels.length === 0) {
                    html = '<div class="col-12 text-muted">No accommodations found.</div>';
                } else {
                    hotels.forEach(function(h, i) {
                        html += `
                            <div class="col-md-6"> 
                                <div class="card shadow-sm p-3 card-content hotel-wrapper">
                                    <label class="w-100 mb-0" style="cursor:pointer;">
                                        <input type="checkbox" name="Accomodations[${i}].Id" value="${h.id}" class="hotel-checkbox me-2" />
                                        <span class="fw-bold text-dark fs-5">🏨 ${h.name}</span>
                                        <div class="text-muted small ms-4">${h.location}</div>
                                        <div class="text-primary-custom fw-bold mt-1 ms-4">$${h.pricePerNight || 0} / night</div>
                                    </label>

                                    <div class="hotel-dates ms-4">
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <label class="small text-muted fw-bold">Check-in</label>
                                                <input type="date" name="Accomodations[${i}].CheckInDate" class="form-control form-control-sm date-input" disabled />
                                            </div>
                                            <div class="col-6">
                                                <label class="small text-muted fw-bold">Check-out</label>
                                                <input type="date" name="Accomodations[${i}].CheckOutDate" class="form-control form-control-sm date-input" disabled />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                }
                $("#hotelsContainer").html(html);

                $(".hotel-checkbox").change(function() {
                    var wrapper = $(this).closest('.hotel-wrapper');
                    var dateInputs = wrapper.find('.date-input');
                    var dateSection = wrapper.find('.hotel-dates');

                    if(this.checked) {
                        dateSection.slideDown();
                        dateInputs.prop('disabled', false).prop('required', true);
                        wrapper.css('border-color', '#28b5a4');
                    } else {
                        dateSection.slideUp();
                        dateInputs.prop('disabled', true).prop('required', false).val('');
                        wrapper.css('border-color', 'transparent');
                    }
                });
            }

            function renderActivities(activities) {
                var html = '';
                if(!activities || activities.length === 0) {
                    html = '<div class="col-12 text-muted">No activities found.</div>';
                } else {
                    activities.forEach(function(a) {
                        html += `
                            <div class="col-md-4">
                                <label class="w-100 selectable-card">
                                    <input type="checkbox" name="ActivitiesId" value="${a.id}" class="hidden-checkbox item-selector" />
                                    <div class="card-content p-3 shadow-sm card">
                                        <div class="fw-bold text-dark">🎯 ${a.name}</div>
                                        <div class="text-muted small">${a.location}</div>
                                        <div class="text-primary-custom fw-bold mt-2">$${a.price || 0}</div>
                                    </div>
                                </label>
                            </div>
                        `;
                    });
                }
                $("#activitiesContainer").html(html);
            }

        });
    </script>
}