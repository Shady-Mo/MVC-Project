@model MVCProject.ViewModels.AccountViewModels.VerifyEmailViewModel

@{
    ViewData["Title"] = "Email Sent";
    Layout = "_LoginLayout";
}

<div class="tm-login-container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-11 col-md-8 col-lg-5">
                <div class="card tm-login-card border-light shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <!-- Success Icon & Header -->
                        <div class="text-center mb-4 mb-md-5">
                            <div class="mb-3">
                                <div class="tm-success-icon">
                                    <i class="fa fa-check-circle fa-3x tm-text-teal"></i>
                                </div>
                            </div>
                            <h2 class="h3 h2-md fw-bold text-dark mb-2">Email Sent Successfully!</h2>
                            <p class="text-muted mb-0">Check your inbox for password reset instructions.</p>
                        </div>

                        <!-- Email Confirmation Info -->
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="fa fa-envelope-circle-check me-3 fa-lg"></i>
                                <div>
                                    <strong>Confirmation</strong>
                                    <p class="mb-0 small mt-1">
                                        A password reset link has been sent to:
                                        <br>
                                        <span class="fw-semibold text-dark">@Model?.Email</span>
                                    </p>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>

                        <!-- Instructions -->
                        <div class="tm-instructions-box mb-4 mb-md-5">
                            <h5 class="fw-semibold text-dark mb-3">
                                <i class="fa fa-list-check me-2 tm-text-teal"></i>What's Next?
                            </h5>
                            <ul class="list-unstyled ms-3">
                                <li class="mb-2 d-flex align-items-start">
                                    <i class="fa fa-circle-small tm-text-orange me-3" style="margin-top: 0.35rem;"></i>
                                    <span class="small">Check your email inbox for a message from us</span>
                                </li>
                                <li class="mb-2 d-flex align-items-start">
                                    <i class="fa fa-circle-small tm-text-orange me-3" style="margin-top: 0.35rem;"></i>
                                    <span class="small">Click the password reset link in the email</span>
                                </li>
                                <li class="mb-2 d-flex align-items-start">
                                    <i class="fa fa-circle-small tm-text-orange me-3" style="margin-top: 0.35rem;"></i>
                                    <span class="small">Follow the instructions to create a new password</span>
                                </li>
                                <li class="d-flex align-items-start">
                                    <i class="fa fa-circle-small tm-text-orange me-3" style="margin-top: 0.35rem;"></i>
                                    <span class="small">Log in with your new password</span>
                                </li>
                            </ul>
                        </div>

                        <!-- Important Note -->
                        <div class="alert alert-warning mb-4" role="alert">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            <small><strong>Didn't receive the email?</strong> Check your spam or junk folder.</small>
                        </div>

                        <!-- Email Info Box -->
                        <div class="tm-info-box p-3 mb-4 rounded" style="background-color: #f0f8ff; border-left: 4px solid var(--tm-teal);">
                            <small class="text-muted">
                                <i class="fa fa-info-circle me-2 tm-text-teal"></i>
                                The password reset link will expire in 24 hours for security purposes.
                            </small>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-3 mb-4">
                            <a href="https://www.gmail.com" target="_blank" class="btn btn-outline-teal w-100 fw-semibold py-2 py-md-3">
                                <i class="fa fa-envelope me-2"></i>Check Email
                            </a>
                            <a asp-action="VerifyEmail" class="btn btn-secondary w-100 fw-semibold py-2 py-md-3">
                                <i class="fa fa-arrow-left me-2"></i>Try Another Email
                            </a>
                        </div>

                        <!-- Divider -->
                        <hr class="my-3 my-md-4">

                        <!-- Back to Login -->
                        <p class="text-center text-muted small mb-0">
                            Remember your password? <a asp-action="Login" class="tm-link-register fw-semibold text-decoration-none">Log in</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --tm-orange: #fd7e14;
        --tm-orange-dark: #f76707;
        --tm-teal: #20c997;
        --tm-teal-dark: #1da88f;
        --tm-text-dark: #1a1a1a;
        --tm-text-muted: #636e72;
        --tm-bg-light: #f5f7fa;
        --tm-border-light: #e8eef5;
    }

    html,
    body {
        height: 100%;
        margin: 0;
        padding: 0;
        background: linear-gradient(135deg, var(--tm-bg-light) 0%, #e8f0f7 100%);
    }

    .tm-login-container {
        background: transparent;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        width: 100%;
        min-height: 100vh;
    }

    .tm-login-card {
        border-radius: 12px;
        border-color: var(--tm-border-light) !important;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08) !important;
        transition: all 0.3s ease;
    }

    .tm-login-card:hover {
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12) !important;
    }

    .tm-text-orange {
        color: var(--tm-orange);
    }

    .tm-text-teal {
        color: var(--tm-teal);
    }

    .tm-success-icon {
        animation: scaleIn 0.5s ease-in-out;
    }

    @@keyframes scaleIn {
        from {
            opacity: 0;
            transform: scale(0.5);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .alert-success {
        background-color: #d4edda;
        border-color: #c3e6cb;
        color: #155724;
    }

    .alert-success .btn-close {
        filter: invert(1);
    }

    .alert-warning {
        background-color: #fff5e6;
        border-color: #fde4d6;
        color: var(--tm-orange);
    }

    .tm-instructions-box {
        background-color: #f8fbf9;
        border: 1px solid #e8eef5;
        border-radius: 8px;
        padding: 1.25rem;
    }

    .tm-instructions-box h5 {
        border-bottom: 2px solid var(--tm-teal);
        padding-bottom: 0.75rem;
    }

    .tm-info-box {
        background-color: #f0f8ff;
        border-left: 4px solid var(--tm-teal);
    }

    .btn-outline-teal {
        background-color: transparent;
        color: var(--tm-teal);
        border: 2px solid var(--tm-teal);
        border-radius: 6px;
        font-size: 16px;
        transition: all 0.3s ease;
        min-height: 44px;
    }

    .btn-outline-teal:hover {
        background-color: var(--tm-teal);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(32, 201, 151, 0.3);
    }

    .btn-outline-teal:active {
        transform: translateY(0);
    }

    .btn-outline-teal:focus {
        box-shadow: 0 0 0 0.25rem rgba(32, 201, 151, 0.25);
        outline: none;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        transition: all 0.3s ease;
        min-height: 44px;
    }

    .btn-secondary:hover {
        background-color: #5a6268;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        color: white;
    }

    .btn-secondary:active {
        transform: translateY(0);
    }

    .btn-secondary:focus {
        box-shadow: 0 0 0 0.25rem rgba(108, 117, 125, 0.25);
    }

    .tm-link-register {
        color: var(--tm-teal);
        transition: all 0.3s ease;
    }

    .tm-link-register:hover {
        color: var(--tm-teal-dark);
        text-decoration: underline !important;
    }

    .fa-circle-small {
        font-size: 0.5rem;
    }

    @@media (max-width: 575px) {
        .tm-login-card {
            border-radius: 8px;
        }

        .card-body {
            padding: 1.25rem !important;
        }

        .h2-md {
            font-size: 1.5rem;
        }

        .py-2 {
            padding-top: 0.5rem !important;
            padding-bottom: 0.5rem !important;
        }

        .tm-instructions-box {
            padding: 1rem;
        }
    }

    @@media (min-width: 576px) {
        .h2-md {
            font-size: 1.75rem;
        }
    }

    @@media (max-width: 359px) {
        .tm-login-card {
            border-radius: 8px;
        }

        .card-body {
            padding: 1rem !important;
        }

        .fa-3x {
            font-size: 2rem;
        }

        .h2-md {
            font-size: 1.25rem;
        }

        .tm-instructions-box {
            padding: 0.75rem;
        }
    }

    @@media (max-width: 600px) and (orientation: landscape) {
        .tm-login-container {
            padding: 2rem 0;
        }

        .card-body {
            padding: 1.5rem !important;
        }

        .mb-4,
        .mb-md-5 {
            margin-bottom: 0.75rem !important;
        }
    }

    @@media (hover: none) and (pointer: coarse) {
        .btn-outline-teal:active {
            transform: translateY(-1px);
        }

        .btn-secondary:active {
            transform: translateY(-1px);
        }
    }

    @@media print {
        .tm-login-container {
            background: none;
        }

        .btn-outline-teal,
        .btn-secondary,
        .btn-close {
            display: none;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
