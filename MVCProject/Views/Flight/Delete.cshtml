@using MVCProject.ViewModels.FlightViewModels
@model DisplayFlightVM
@{
    ViewData["Title"] = "Delete Flight";
}

<style>
    .text-primary-custom { color: #28b5a4 !important; }
    .bg-primary-custom { background-color: #28b5a4 !important; color: white; }
</style>

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 border-top border-danger" style="border-top-width: 4px !important;">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="mb-0 fw-bold">🗑️ Delete Flight</h4>
        </div>
        <div class="card-body">
            <p class="text-muted mb-4">Are you sure you want to delete this flight? This action cannot be undone.</p>

            <div class="bg-light rounded p-3 mb-4">
                <p class="mb-1"><span class="fw-bold text-muted">Airline:</span> @Model.Airline</p>
                <p class="mb-1"><span class="fw-bold text-muted">Route:</span> @Model.DepartureAirport → @Model.DestinationAirport</p>
                <p class="mb-1"><span class="fw-bold text-muted">Departure:</span> @Model.DepartureDateTime.ToString("MMM dd, yyyy — HH:mm")</p>
                <p class="mb-1"><span class="fw-bold text-muted">Arrival:</span> @Model.ArrivalDateTime.ToString("MMM dd, yyyy — HH:mm")</p>
                <p class="mb-1"><span class="fw-bold text-muted">Price:</span> @Model.Price.ToString("C")</p>
                <p class="mb-0"><span class="fw-bold text-muted">Available Seats:</span> @Model.AvailableSeats</p>
            </div>

            <div class="d-flex gap-2">
                <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
</div>