@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVCProject</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVCProject.styles.css" asp-append-version="true" />
    <style>
        /* Make footer stick to bottom of page */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: fit-content;
        }

        /* Main content grows to push footer down */
        main {
            flex: 1 0 auto;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* Footer stays at bottom of page (scrolls with content) */
        .footer {
            flex-shrink: 0;
            background: linear-gradient(135deg, #1a2a3a 0%, #0f1923 100%);
            color: #fff;
            padding: 20px 0;
            border-top: 3px solid #3ac0ad;
            box-shadow: 0 -4px 15px rgba(0,0,0,0.1);
        }

        /* Custom Styles */
        .top-bar {
            background: #3ac0ad;
            color: white;
            padding: 12px 0;
            font-size: 14px;
            position: relative;
            z-index: 1001;
        }

        .top-bar .contact-info {
            display: flex;
            gap: 20px;
            align-items: center;
            flex-wrap: wrap;
        }

        .top-bar .social-icons a {
            color: white;
            margin-right: 15px;
            text-decoration: none;
            transition: opacity 0.3s;
        }

        .top-bar .social-icons a:hover {
            opacity: 0.8;
        }

        .top-bar .contact-info i {
            margin-right: 8px;
        }

        .top-bar .separator {
            width: 1px;
            height: 15px;
            background: rgba(255,255,255,0.5);
            margin: 0 10px;
        }

        .top-bar .auth-links {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 20px;
            flex-wrap: wrap;
        }

        .top-bar .auth-links a, .top-bar .auth-links form button {
            color: white;
            text-decoration: none;
            transition: opacity 0.3s;
            background: none;
            border: none;
            padding: 0;
            font-weight: bold;
        }

        .top-bar .auth-links a:hover, .top-bar .auth-links form button:hover {
            opacity: 0.8;
        }

        /* Main Navigation */
        .main-nav {
            background: white;
            padding: 15px 0;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            transition: transform 0.3s ease;
        }

        .logo:hover {
            transform: translateY(-2px);
        }

        .logo-icon {
            background: linear-gradient(135deg, #3ac0ad 0%, #3ac0ad 50%, #f4b266 100%);
            color: white;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            font-size: 20px;
            transform: rotate(45deg);
            box-shadow: 0 4px 10px rgba(58,192,173,0.3);
            transition: box-shadow 0.3s ease;
        }

        .logo-icon:hover {
            box-shadow: 0 6px 15px rgba(58,192,173,0.4);
        }

        .logo-icon i {
            transform: rotate(-45deg);
        }

        .logo-text {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
        }

        .logo-text .travel {
            font-size: 16px;
            color: #666;
            font-weight: 500;
            letter-spacing: 1px;
        }

        .logo-text .monster {
            font-size: 22px;
            color: #222;
            font-weight: 800;
            letter-spacing: 1px;
        }

        /* Navbar Toggle Button */
        .navbar-toggler {
            border: 2px solid #3ac0ad;
            padding: 8px 10px;
            background: transparent;
            border-radius: 6px;
            transition: all 0.3s ease;
        }

        .navbar-toggler:focus {
            box-shadow: 0 0 0 3px rgba(58,192,173,0.25);
            outline: none;
            border-color: #3ac0ad;
        }

        .navbar-toggler:hover {
            border-color: #2aac99;
            background: rgba(58,192,173,0.05);
        }

        .navbar-toggler.collapsed:not(.collapsed) {
            background: rgba(58,192,173,0.1);
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(58,192,173,0.8)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
            width: 1.5em;
            height: 1.5em;
            background-size: 100%;
        }

        .nav-menu {
            display: flex;
            align-items: center;
            gap: 30px;
            flex-wrap: wrap;
        }

        .nav-menu a {
            text-decoration: none;
            color: #555;
            font-weight: 600;
            font-size: 15px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
            position: relative;
        }

        .nav-menu a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -5px;
            left: 0;
            background: #3ac0ad;
            transition: width 0.3s ease;
        }

        .nav-menu a.selected {
            color: #3ac0ad;
        }

        .nav-menu a.active::after {
            width: 100%;
        }

        .nav-menu a:hover, .nav-menu a.active {
            color: #3ac0ad;
        }

        .nav-menu a:hover::after, .nav-menu a.active::after {
            width: 100%;
        }

        .search-icon {
            color: #555;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 16px;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .search-icon:hover {
            color: white;
            background: #3ac0ad;
            transform: scale(1.1);
        }

        /* Footer inner content styles */
        .footer-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .mini-logo {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .mini-logo i {
            background: linear-gradient(135deg, #3ac0ad 0%, #f4b266 100%);
            color: white;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            font-size: 18px;
            box-shadow: 0 4px 10px rgba(58,192,173,0.3);
        }

        .mini-logo span {
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 1.5px;
            background: linear-gradient(135deg, #3ac0ad 0%, #f4b266 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .footer-copyright {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .footer-copyright p {
            color: #888;
            font-size: 12px;
            margin: 0;
        }

        .footer-links {
            display: flex;
            gap: 30px;
            flex-wrap: wrap;
        }

        .footer-links a {
            color: #bbb;
            text-decoration: none;
            font-size: 13px;
            transition: all 0.3s ease;
            font-weight: 500;
            position: relative;
        }

        .footer-links a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -5px;
            left: 0;
            background: #3ac0ad;
            transition: width 0.3s ease;
        }

        .footer-links a:hover {
            color: #3ac0ad;
        }

        .footer-links a:hover::after {
            width: 100%;
        }

        .footer-social {
            display: flex;
            gap: 15px;
        }

        .footer-social a {
            color: #bbb;
            text-decoration: none;
            font-size: 16px;
            transition: all 0.3s ease;
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 50%;
        }

        .footer-social a:hover {
            color: white;
            border-color: #3ac0ad;
            background: rgba(58,192,173,0.1);
            transform: translateY(-3px);
            box-shadow: 0 4px 12px rgba(58,192,173,0.3);
        }

        /* Mobile Menu Styles */
        .mobile-menu-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
        }

        .mobile-menu-overlay.active {
            display: block;
        }

        .mobile-menu {
            display: flex;
            position: fixed;
            top: 0;
            left: -70%;
            width: 70%;
            height: 100vh;
            background: white;
            z-index: 1001;
            padding: 20px;
            overflow-y: auto;
            transition-duration: 0.3s;
            flex-direction: column;
            gap: 15px;
        }

        .mobile-menu.active {
            display: flex;
            left: 0;
        }

        .mobile-menu-close {
            align-self: flex-end;
            background: none;
            border: none;
            font-size: 28px;
            color: #555;
            cursor: pointer;
            padding: 0;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.3s ease;
            margin-bottom: 15px;
        }

        .mobile-menu-close:hover {
            color: #3ac0ad;
        }

        .mobile-menu-item {
            text-decoration: none;
            color: #555;
            font-weight: 500;
            font-size: 15px;
            padding: 12px 0;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            transition: color 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .mobile-menu-item:hover {
            color: #3ac0ad;
        }

        .mobile-menu-item.logout-btn {
            background: none;
            border: none;
            padding: 12px 0;
            width: 100%;
            text-align: left;
            color: #d32f2f;
            cursor: pointer;
        }

        .mobile-menu-item.logout-btn:hover {
            color: #b71c1c;
        }

        .mobile-menu-divider {
            height: 1px;
            background: rgba(0, 0, 0, 0.1);
            margin: 10px 0;
        }

        .mobile-menu-contact {
            padding: 15px 0;
            border-top: 1px solid rgba(0, 0, 0, 0.1);
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        }

        .mobile-menu-contact-item {
            color: #555;
            font-size: 14px;
            margin: 10px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .mobile-menu-contact-item i {
            color: #3ac0ad;
            width: 20px;
        }

        .mobile-menu-contact-link {
            color: #3ac0ad;
            text-decoration: none;
            font-weight: 500;
        }

        .mobile-menu-social {
            display: flex;
            gap: 15px;
            padding: 15px 0;
            border-top: 1px solid rgba(0, 0, 0, 0.1);
        }

        .mobile-menu-social a {
            color: #555;
            font-size: 20px;
            transition: color 0.3s ease;
        }

        .mobile-menu-social a:hover {
            color: #3ac0ad;
        }

        /* Responsive Breakpoints */
        @@media (max-width: 991px) {
            .top-bar {
                display: none;
            }

            .nav-menu {
                margin-top: 15px;
                justify-content: center;
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .footer-content {
                flex-direction: column;
                text-align: center;
                gap: 15px;
            }

            .footer-links {
                justify-content: center;
            }

            .footer-social {
                justify-content: center;
            }
        }

        @@media (max-width: 768px) {
            .top-bar .contact-info {
                flex-direction: column;
                gap: 8px;
            }

            .top-bar .separator {
                display: none;
            }

            .nav-menu {
                gap: 10px;
            }

            .nav-menu a {
                font-size: 13px;
                padding: 8px 0;
            }

            .logo-text .travel {
                font-size: 12px;
            }

            .logo-text .monster {
                font-size: 18px;
            }

            .logo-icon {
                width: 32px;
                height: 32px;
                font-size: 16px;
            }

            .footer-copyright {
                margin-top: 10px;
            }

            .footer-social {
                gap: 8px;
            }
        }

        @@media (max-width: 576px) {
            .nav-menu {
                flex-direction: column;
                gap: 10px;
            }

            .navbar-collapse {
                display: none !important;
            }

            .footer-links {
                flex-direction: column;
                gap: 8px;
            }

            .main-nav .navbar {
                padding: 10px 0;
            }

            .logo {
                gap: 8px;
            }

            .logo-text .monster {
                font-size: 16px;
            }

            .footer {
                padding: 15px 0;
            }

            .footer-content {
                flex-direction: column;
            }

            .footer-links {
                gap: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Top Bar -->
    <div class="top-bar">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 col-md-12 text-lg-start text-center mb-2 mb-lg-0">
                    <div class="contact-info justify-content-center justify-content-lg-start">
                        <div class="social-icons">
                            <a href="#"><i class="fab fa-facebook-f"></i></a>
                            <a href="#"><i class="fab fa-twitter"></i></a>
                            <a href="#"><i class="fab fa-instagram"></i></a>
                        </div>
                        <div class="separator d-none d-md-block"></div>
                        <span><i class="fas fa-phone-alt"></i>@User.FindFirst("PhoneNumber")?.Value</span>
                        <span><i class="fas fa-envelope"></i>@User.FindFirst(ClaimTypes.Email)?.Value</span>
                    </div>
                </div>
                <div class="col-lg-4 col-md-12">
                    <div class="auth-links justify-content-center justify-content-lg-end">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Profile" asp-action="Index">Welcome, @User.Identity.Name</a>
                            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                                <button type="submit">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login">Login</a>
                            <a asp-controller="Account" asp-action="Register">Sign Up</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <button class="mobile-menu-close" id="mobileMenuClose">
            <i class="fas fa-times"></i>
        </button>

        <a href="#" class="mobile-menu-item">
            <i class="fas fa-home"></i> Home
        </a>
        <a href="#" class="mobile-menu-item">
            <i class="fas fa-plane"></i> All Trips
        </a>
        <a href="#" class="mobile-menu-item">
            <i class="fas fa-map-marker-alt"></i> Destination
        </a>
        <a href="#" class="mobile-menu-item">
            <i class="fas fa-hiking"></i> Activities
        </a>
        <a href="#" class="mobile-menu-item">
            <i class="fas fa-tag"></i> Trip Types
        </a>
        <a href="#" class="mobile-menu-item">
            Blog
        </a>
        <a href="#" class="mobile-menu-item">
            <i class="fas fa-file-alt"></i> Pages
        </a>
        <a href="#" class="mobile-menu-item">
            <i class="fas fa-envelope"></i> Contact
        </a>

        <div class="mobile-menu-divider"></div>

        @if (User.Identity.IsAuthenticated)
        {
            <a asp-controller="Profile" asp-action="Index" class="mobile-menu-item">
                <i class="fas fa-user"></i> Welcome, @User.Identity.Name
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="mobile-menu-item logout-btn">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="mobile-menu-item">
                <i class="fas fa-sign-in-alt"></i> Login
            </a>
            <a asp-controller="Account" asp-action="Register" class="mobile-menu-item">
                <i class="fas fa-user-plus"></i> Sign Up
            </a>
        }

        <div class="mobile-menu-contact">
            <div class="mobile-menu-contact-item">
                <i class="fas fa-phone-alt"></i>
                <a href="tel:+20@(User.FindFirst("PhoneNumber")?.Value)" class="mobile-menu-contact-link">@(User.FindFirst("PhoneNumber")?.Value)</a>
            </div>
            <div class="mobile-menu-contact-item">
                <i class="fas fa-envelope"></i>
                <a href="mailto:@(User.FindFirst(ClaimTypes.Email)?.Value)" class="mobile-menu-contact-link">@(User.FindFirst(ClaimTypes.Email)?.Value)</a>
            </div>
        </div>

        <div class="mobile-menu-social">
            <a href="#"><i class="fab fa-facebook-f"></i></a>
            <a href="#"><i class="fab fa-twitter"></i></a>
            <a href="#"><i class="fab fa-instagram"></i></a>
        </div>
    </div>

    <!-- Main Navigation with Bootstrap Navbar Toggle -->
    <div class="main-nav">
        <div class="container p-0">
            <nav class="navbar navbar-expand-lg p-0 justify-content-center">
                <div class="row w-100 align-items-center">
                    <div class="col-6 col-lg-3">
                        <a asp-controller="Home" asp-action="Index" class="logo">
                            <div class="logo-icon">
                                <i class="fas fa-plane"></i>
                            </div>
                            <div class="logo-text">
                                <span class="travel">TRAVEL</span>
                                <span class="monster">MONSTER</span>
                            </div>
                        </a>
                    </div>
                    <div class="col-6 col-lg-9">
                        <button class="navbar-toggler float-end" type="button" id="mobileMenuToggle">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="navbarNav">
                            <div class="nav-menu ms-lg-auto w-100 w-lg-auto justify-content-end">
                                <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "selected" : "")">Home</a>
                                <a asp-controller="Flight" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Flight" ? "selected" : "")">Flights</a>
                                <a asp-controller="Accomodation" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Accomodation" ? "selected" : "")">Accommodations</a>
                                <a asp-controller="Activity" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Activity" ? "selected" : "")">Activities</a>
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a asp-controller="Booking" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" ? "selected" : "")">Bookings</a>
                                }
                                <div class="search-icon">
                                    <i class="fas fa-search"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </div>
    </div>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer - Stays at bottom of page (scrolls with content) -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="text-center text-lg-start">
                    <div class="mini-logo justify-content-center justify-content-lg-start">
                        <i class="fas fa-plane"></i>
                        <span>TRAVEL MONSTER</span>
                    </div>
                    <div class="footer-copyright mt-1">
                        <p>© 2026 All Rights Reserved</p>
                    </div>
                </div>
                <div class="footer-links">
                    <a href="#">Home</a>
                    <a href="#">Flights</a>
                    <a href="#">Accommodations</a>
                    <a href="#">Activities</a>
                    <a href="#">Privacy</a>
                    <a href="#">Terms</a>
                </div>
                <div class="footer-social">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const mobileMenuToggle = document.getElementById('mobileMenuToggle');
            const mobileMenu = document.getElementById('mobileMenu');
            const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
            const mobileMenuClose = document.getElementById('mobileMenuClose');
            const mobileMenuItems = document.querySelectorAll('.mobile-menu-item');
            const navMenuText = document.querySelectorAll('.nav-menu a');

            navMenuText.forEach(item => {
                item.addEventListener('click', function(e) {
                    navMenuText.forEach(item => {
                        item.classList.remove('selected');
                    });

                    e.target.classList.add('selected');
                });
            });

            // Open mobile menu
            mobileMenuToggle.addEventListener('click', function() {
                mobileMenu.classList.add('active');
                mobileMenuOverlay.classList.add('active');
                document.body.style.overflow = 'hidden';
            });

            // Close mobile menu
            function closeMobileMenu() {
                mobileMenu.classList.remove('active');
                mobileMenuOverlay.classList.remove('active');
                document.body.style.overflow = 'auto';
            }

            mobileMenuClose.addEventListener('click', closeMobileMenu);
            mobileMenuOverlay.addEventListener('click', closeMobileMenu);

            // Close menu when a menu item is clicked
            mobileMenuItems.forEach(item => {
                item.addEventListener('click', closeMobileMenu);
            });

            // Close menu on window resize if it's larger than mobile
            window.addEventListener('resize', function() {
                if (window.innerWidth > 576) {
                    closeMobileMenu();
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
