@model IEnumerable<DisplayActivityVM>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>My Activities | Outdoor Adventures</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/css/activities-list.css">
    <style>
            .Add-Activity {
                transition-duration: 0.3s;
            }

                .Add-Activity:hover {
                    background-color: #0d9488 !important;
                }

            .btn-edit {
                background-color: #f59e0b;
                color: white;
                padding: 0.5rem 1rem;
                border-radius: 6px;
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 500;
            }

            .btn-edit:hover {
                background-color: #d97706;
                color: white;
            }

            @@media (max-width: 900px) {
                .content-area {
                    width: 100%;
                }
            }

            @@media (max-width: 768px) {
                .Add-Activity span {
                    display: none;
                }
            }
    </style>
</head>
<body>
    <div class="activities-container">
        <div class="page-header" style="border-bottom: none; margin-bottom: 1rem;">
            <div class="title-section" style="display: flex; gap: 1rem; flex: 1; flex-wrap: wrap; align-items: stretch;">
                <div style="flex: 0 0 auto; min-width: 200px;">
                    <h2 class="filter-title" style="margin-bottom: 0; white-space: nowrap;">My Activities Filter</h2>
                </div>
                <div style="flex: 1; display:flex; gap: 1rem; align-items:center; flex-wrap: wrap; min-width: 200px;">
                    <div style="display:flex; align-items:center; background:#f1f5f9; padding: 0.5rem 1rem; border-radius: 8px; flex:1; min-width: 150px;">
                        <i class="fas fa-search" style="color: #94a3b8; margin-right: 0.5rem; flex-shrink: 0;"></i>
                        <input type="text" form="filterForm" name="searchQuery" value="@Context.Request.Query["searchQuery"]" placeholder="Search my activities" style="border: none; background: transparent; outline: none; width: 100%; color: #334155; font-size: 0.9rem;" />
                    </div>
                    
                    <a href="@Url.Action("Create", "Activity")" class="Add-Activity" style="background:#14b8a6; color:#fff; padding: 0.6rem 1.2rem; border-radius: 8px; text-decoration:none; font-weight:600; white-space:nowrap; display:flex; align-items:center; gap:0.5rem; flex-shrink: 0;">
                        <i class="fas fa-plus"></i><span> Add Activity</span>
                    </a>

                </div>
            </div>
            <div class="sorting-bar">
                <span class="sort-label"><i class="fas fa-arrow-down-wide-short"></i> Sort</span>
                <button class="sort-option active" data-sort="recent">Recently Added</button>
                <button class="sort-option" data-sort="price-low">Price: Low to High</button>
                <button class="sort-option" data-sort="price-high">Price: High to Low</button>
            </div>
        </div>

        <form id="filterForm" method="get" action="@Url.Action("SellerActivities", "Activity")">
            <div class="main-layout">
                <div class="sidebar-filters">

                    <div class="filter-section">
                        <div class="filter-title">Price <i class="fas fa-chevron-up" style="color:#94a3b8; font-size:0.8rem;"></i></div>
                        <div class="slider-container">
                            <input type="range" name="maxPrice" min="0" max="5000" step="10" value="@(Context.Request.Query["maxPrice"].ToString() == "" ? "5000" : Context.Request.Query["maxPrice"])" style="width: 100%; accent-color: #ff6b35;" oninput="document.getElementById('priceVal').innerText = '$' + this.value">
                        </div>
                        <div class="slider-values">
                            <span>$0</span>
                            <span id="priceVal">$@(Context.Request.Query["maxPrice"].ToString() == "" ? "5000" : Context.Request.Query["maxPrice"])</span>
                        </div>
                    </div>

                    <div class="filter-section">
                        <div class="filter-title">Capacity (Min) <i class="fas fa-chevron-up" style="color:#94a3b8; font-size:0.8rem;"></i></div>
                        <div class="slider-container">
                            <input type="range" name="minCapacity" min="1" max="50" step="1" value="@(Context.Request.Query["minCapacity"].ToString() == "" ? "1" : Context.Request.Query["minCapacity"])" style="width: 100%; accent-color: #ff6b35;" oninput="document.getElementById('capVal').innerText = this.value + ' Persons'">
                        </div>
                        <div class="slider-values">
                            <span>1</span>
                            <span id="capVal">@(Context.Request.Query["minCapacity"].ToString() == "" ? "1" : Context.Request.Query["minCapacity"]) Persons</span>
                        </div>
                        <button type="submit" class="filter-btn">Apply Filters</button>
                    </div>

                </div>

                <div class="content-area">
                    <div id="activitiesGrid" class="activities-grid"></div>

                    @if (ViewBag.TotalPages > 1)
                    {
                        <div class="pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-top: 2rem;">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <a href="@Url.Action("SellerActivities", new { searchQuery = Context.Request.Query["searchQuery"], maxPrice = Context.Request.Query["maxPrice"], minCapacity = Context.Request.Query["minCapacity"], pageNumber = ViewBag.CurrentPage - 1 })"
                                       class="page-btn" style="padding: 0.5rem 1rem; border: 1px solid #dee2e6; border-radius: 8px; color: #333; text-decoration: none; font-weight: 500;">
                                    Previous
                                </a>
                            }

                            @{
                                int maxPagesToShow = 10;
                                int startPage = Math.Max(1, ViewBag.CurrentPage - (maxPagesToShow / 2));
                                int endPage = Math.Min(ViewBag.TotalPages, startPage + maxPagesToShow - 1);

                                if (endPage - startPage + 1 < maxPagesToShow)
                                {
                                    startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                }
                            }

                            @if (startPage > 1)
                            {
                                <a href="@Url.Action("SellerActivities", new { searchQuery = Context.Request.Query["searchQuery"], maxPrice = Context.Request.Query["maxPrice"], minCapacity = Context.Request.Query["minCapacity"], pageNumber = 1 })"
                                       class="page-btn" style="padding: 0.5rem 1rem; border: 1px solid #dee2e6; border-radius: 8px; color: #333; text-decoration: none; font-weight: 500;">
                                    1
                                </a>
                                @if (startPage > 2)
                                {
                                    <span style="padding: 0.5rem 1rem; color: #6c757d;">...</span>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <a href="@Url.Action("SellerActivities", new { searchQuery = Context.Request.Query["searchQuery"], maxPrice = Context.Request.Query["maxPrice"], minCapacity = Context.Request.Query["minCapacity"], pageNumber = i })"
                                       class="page-btn @(i == ViewBag.CurrentPage ? "active" : "")"
                                       style="padding: 0.5rem 1rem; border: 1px solid #dee2e6; border-radius: 8px; text-decoration: none; font-weight: 500; @(i == ViewBag.CurrentPage ? "background-color: #14b8a6; color: white; border-color: #14b8a6;" : "color: #333;")">
                                    @i
                                </a>
                            }

                            @if (endPage < ViewBag.TotalPages)
                            {
                                @if (endPage < ViewBag.TotalPages - 1)
                                {
                                    <span style="padding: 0.5rem 1rem; color: #6c757d;">...</span>
                                }
                                <a href="@Url.Action("SellerActivities", new { searchQuery = Context.Request.Query["searchQuery"], maxPrice = Context.Request.Query["maxPrice"], minCapacity = Context.Request.Query["minCapacity"], pageNumber = ViewBag.TotalPages })"
                                       class="page-btn" style="padding: 0.5rem 1rem; border: 1px solid #dee2e6; border-radius: 8px; color: #333; text-decoration: none; font-weight: 500;">
                                    @ViewBag.TotalPages
                                </a>
                            }

                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <a href="@Url.Action("SellerActivities", new { searchQuery = Context.Request.Query["searchQuery"], maxPrice = Context.Request.Query["maxPrice"], minCapacity = Context.Request.Query["minCapacity"], pageNumber = ViewBag.CurrentPage + 1 })"
                                       class="page-btn" style="padding: 0.5rem 1rem; border: 1px solid #dee2e6; border-radius: 8px; color: #333; text-decoration: none; font-weight: 500;">
                                    Next
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </form>

    </div>

    <script>
            // ---------- DYNAMIC ACTIVITIES DATA ----------
            const activitiesData = [
            @foreach (var activity in Model)
            {
                    <text>
                        {
                            id: @activity.Id,
                            title: "@Html.Raw(activity.Name.Replace("\"", "\\\""))",
                            seller: "@Html.Raw((activity.SellerName ?? "Me").Replace("\"", "\\\""))",
                            description: "@Html.Raw(activity.Location.Replace("\"", "\\\""))",
                            duration: "1 Day(s)",
                            oldPrice: @activity.Price,
                            newPrice: @activity.Price,
                            saving: 0,
                            departures: ["@(activity.Date.ToString("MMMM dd, yyyy"))"],
                            category: "all",
                            image: "@(string.IsNullOrEmpty(activity.Img) ? "https://picsum.photos/id/104/400/250" : Url.Content("~/images/" + activity.Img))",
                            group: "@activity.Capacity persons",
                            addedDate: "@(activity.Date.ToString("yyyy-MM-dd"))"
                        },
                    </text>
            }
            ];

            let currentSort = "recent";

            function filterAndSortActivities() {
                let filtered = [...activitiesData];
                if (currentSort === "recent") {
                    filtered.sort((a,b) => new Date(b.addedDate) - new Date(a.addedDate));
                } else if (currentSort === "price-low") {
                    filtered.sort((a,b) => a.newPrice - b.newPrice);
                } else if (currentSort === "price-high") {
                    filtered.sort((a,b) => b.newPrice - a.newPrice);
                }
                return filtered;
            }

            function renderActivities() {
                const grid = document.getElementById("activitiesGrid");
                const filteredList = filterAndSortActivities();

                if (filteredList.length === 0) {
                    grid.innerHTML = `<div style="grid-column:1/-1; text-align:center; padding:3rem;"><i class="fas fa-box-open" style="font-size: 2rem; color: #94a3b8; margin-bottom: 1rem;"></i><br>You haven't added any activities matching this criteria yet.</div>`;
                    return;
                }

                grid.innerHTML = filteredList.map(activity => {
                    const oldPriceFmt = `$${activity.oldPrice.toLocaleString()}`;
                    const newPriceFmt = `$${activity.newPrice.toLocaleString()}`;
                    const savingHtml = activity.saving > 0 ? `<span class="save-badge">You save $${activity.saving}</span>` : '';
                    const oldPriceHtml = activity.saving > 0 ? `<span class="old-price">${oldPriceFmt}</span>` : '';

                    const departuresHtml = activity.departures.map(d => `<span class="date-badge available"><i class="fas fa-check"></i>${d} (Available)</span>`).join('');
                    
                    const groupIcon = `<i class="far fa-user"></i> ${activity.group}`;
                    const sellerIcon = `<i class="fas fa-store"></i> ${activity.seller}`;

                    const detailsUrl = '@Url.Action("Details", "Activity")/' + activity.id;
                    const editUrl = '@Url.Action("Edit", "Activity")/' + activity.id; // لينك تعديل النشاط عشان ده البائع

                    return `
                        <div class="activity-card">
                            <div class="card-img" style="background-image: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.2)), url('${activity.image}');">
                                <span class="img-cat-tag" style="background-color: #0ea5e9;"><i class="fas fa-user-tag"></i> My Activity</span>
                            </div>
                            <div class="card-content">
                                <div class="card-main-info">
                                    <h3 class="activity-title">${activity.title}</h3>
                                    <p class="activity-desc">${activity.description}</p>
                                    <div class="meta-list">
                                        <span class="meta-item">${groupIcon}</span>
                                        <span class="meta-item" style="margin-left: 12px; color: #0d9488;">${sellerIcon}</span>
                                    </div>
                                </div>
                                <div class="card-price-action">
                                    <div style="width: 100%;">
                                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                            <span style="color: #64748b; font-size: 0.85rem;">Duration<br><strong style="color: #0f172a;">${activity.duration}</strong></span>
                                            <div class="price-info">
                                                <span style="color: #64748b; font-size: 0.85rem; display: flex; align-items:center; gap: 4px;">From ${oldPriceHtml}</span>
                                                <span class="new-price">${newPriceFmt}</span>
                                                ${savingHtml}
                                            </div>
                                        </div>
                                        <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
                                            <a href="${detailsUrl}" class="btn-details" style="flex: 1; text-align: center; text-decoration:none;">View</a>
                                            <a href="${editUrl}" class="btn-edit" style="flex: 1; text-align: center;"><i class="fas fa-pen"></i> Edit</a>
                                        </div>
                                        <div class="departures" style="margin-top: 1rem;">
                                            <p>Next Departures</p>
                                            <div class="departure-dates">
                                                ${departuresHtml}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            function initFilters() {
                const sortBtns = document.querySelectorAll('.sort-option');
                sortBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const sortValue = btn.getAttribute('data-sort');
                        if (!sortValue) return;
                        sortBtns.forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        currentSort = sortValue;
                        renderActivities();
                    });
                });
            }

            renderActivities();
            initFilters();
    </script>
</body>
</html>