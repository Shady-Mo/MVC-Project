@model AddActivityVM

@{
    ViewData["Title"] = "Create";
}

<style>
    .text-primary-custom { color: #14b8a6 !important; }
    .bg-primary-custom { background-color: #14b8a6 !important; color: white; }
    .btn-primary-custom { background-color: #14b8a6; border-color: #14b8a6; color: white; }
    .btn-primary-custom:hover { background-color: #0d9488; border-color: #0d9488; color: white; }
    .btn-outline-primary-custom { color: #14b8a6; border-color: #14b8a6; }
    .btn-outline-primary-custom:hover { background-color: #14b8a6; border-color: #14b8a6; color: white; }
    .form-control:focus { border-color: #14b8a6; box-shadow: 0 0 0 0.25rem rgba(20, 184, 166, 0.25); }
    .card-custom { border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: none; }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card card-custom">
                <div class="card-header bg-primary-custom text-white text-center py-3 rounded-top" style="border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    <h3 class="mb-0 fw-bold">Create New Activity</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6 form-group">
                                <label asp-for="Name" class="form-label fw-bold text-muted"></label>
                                <input asp-for="Name" class="form-control" placeholder="Activity Name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 form-group">
                                <label asp-for="Location" class="form-label fw-bold text-muted"></label>
                                <input asp-for="Location" class="form-control" placeholder="City or Venue" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 form-group">
                                <label asp-for="Date" class="form-label fw-bold text-muted"></label>
                                <input asp-for="Date" class="form-control" type="datetime-local" />
                                <span asp-validation-for="Date" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 form-group">
                                <label asp-for="Price" class="form-label fw-bold text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Price" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 form-group">
                                <label asp-for="Capacity" class="form-label fw-bold text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text">👥</span>
                                    <input asp-for="Capacity" class="form-control" placeholder="Max participants" />
                                </div>
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 form-group">
                                <label asp-for="ImageFile" class="form-label fw-bold text-muted">Cover Image</label>
                                <input type="file" asp-for="ImageFile" class="form-control" accept="image/*">
                                <span asp-validation-for="ImageFile" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary-custom px-4 fw-bold">Create Activity</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.js"></script>
}
