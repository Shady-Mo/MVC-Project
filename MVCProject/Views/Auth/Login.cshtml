@model MVCProject.ViewModels.AuthViewModels.LoginViewModel

@{
    ViewData["Title"] = "LogIn";
    Layout = "_LoginLayout";
}

<div class="tm-login-container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-11 col-md-8 col-lg-5">
                <div class="card tm-login-card border-light shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4 mb-md-5">
                            <div class="mb-3">
                                <i class="fa fa-user-circle fa-3x tm-text-teal"></i>
                            </div>
                            <h2 class="h3 h2-md fw-bold text-dark mb-2">Welcome Back</h2>
                            <p class="text-muted mb-0">Please enter your account details to log in.</p>
                        </div>

                        <form asp-action="Login" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
                                <strong class="text-orange">Validation Error</strong>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>

                            <div class="mb-3 mb-md-4">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    Email Address <span class="text-orange">*</span>
                                </label>
                                <input asp-for="Email" 
                                       type="email" 
                                       class="form-control tm-form-control" 
                                       placeholder="example@mail.com" 
                                       autocomplete="email" />
                                <span asp-validation-for="Email" class="invalid-feedback d-block text-orange small mt-2"></span>
                            </div>

                            <div class="mb-3 mb-md-4">
                                <label asp-for="Password" class="form-label fw-semibold">
                                    Password <span class="text-orange">*</span>
                                </label>
                                <input asp-for="Password" 
                                       type="password" 
                                       class="form-control tm-form-control" 
                                       placeholder="••••••••" 
                                       autocomplete="current-password" />
                                <span asp-validation-for="Password" class="invalid-feedback d-block text-orange small mt-2"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4 mb-md-5 flex-wrap gap-2">
                                <div class="form-check">
                                    <input asp-for="RememberMe" type="checkbox" class="form-check-input tm-checkbox" id="rememberMe" />
                                    <label asp-for="RememberMe" class="form-check-label small fw-medium">
                                        Remember Me
                                    </label>
                                </div>
                                <a href="#" class="tm-link-forgot small fw-medium text-decoration-none">Forgot Password?</a>
                            </div>

                            <button type="submit" class="btn btn-orange w-100 fw-semibold py-2 py-md-3 mb-4">
                                Log In
                            </button>

                            <hr class="my-3 my-md-4">
                            <p class="text-center text-muted small mb-0">
                                Not a member yet? <a asp-action="Register" class="tm-link-register fw-semibold text-decoration-none">Register now</a>
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --tm-orange: #fd7e14;
        --tm-orange-dark: #f76707;
        --tm-teal: #20c997;
        --tm-teal-dark: #1da88f;
        --tm-text-dark: #1a1a1a;
        --tm-text-muted: #636e72;
        --tm-bg-light: #f5f7fa;
        --tm-border-light: #e8eef5;
    }

    html,
    body {
        height: 100%;
        margin: 0;
        padding: 0;
        background: linear-gradient(135deg, var(--tm-bg-light) 0%, #e8f0f7 100%);
    }

    .tm-login-container {
        background: transparent;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        width: 100%;
        min-height: 100vh;
    }

    .tm-login-card {
        border-radius: 12px;
        border-color: var(--tm-border-light) !important;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08) !important;
        transition: all 0.3s ease;
    }

    .tm-login-card:hover {
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12) !important;
    }

    .tm-text-orange {
        color: var(--tm-orange);
    }

    .tm-text-teal {
        color: var(--tm-teal);
    }

    .tm-form-control {
        border: 1px solid #dfe6e9;
        border-radius: 6px;
        padding: 0.75rem 1rem;
        font-size: 15px;
        transition: all 0.3s ease;
        color: var(--tm-text-muted);
    }

    .tm-form-control::placeholder {
        color: #adb5bd;
    }

    .tm-form-control:focus {
        border-color: var(--tm-teal);
        box-shadow: 0 0 0 3px rgba(32, 201, 151, 0.1);
        background-color: #f8fffe;
        color: var(--tm-text-dark);
    }

    .tm-checkbox {
        width: 18px;
        height: 18px;
        margin-right: 8px;
        cursor: pointer;
        accent-color: var(--tm-teal);
        transition: all 0.2s ease;
    }

    .tm-checkbox:focus {
        box-shadow: 0 0 0 0.25rem rgba(32, 201, 151, 0.25);
    }

    .btn-orange {
        background-color: var(--tm-orange);
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        transition: all 0.3s ease;
        min-height: 44px;
    }

    .btn-orange:hover {
        background-color: var(--tm-orange-dark);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(253, 126, 20, 0.3);
        color: white;
    }

    .btn-orange:active {
        transform: translateY(0);
    }

    .btn-orange:focus {
        box-shadow: 0 0 0 0.25rem rgba(253, 126, 20, 0.25);
    }

    .tm-link-forgot,
    .tm-link-register {
        color: var(--tm-teal);
        transition: all 0.3s ease;
    }

    .tm-link-forgot:hover,
    .tm-link-register:hover {
        color: var(--tm-teal-dark);
        text-decoration: underline !important;
    }

    .alert-warning {
        background-color: #fff5e6;
        border-color: #fde4d6;
        color: var(--tm-orange);
    }

    .text-orange {
        color: var(--tm-orange);
    }

    @@media (max-width: 575px) {
        .tm-login-card {
            border-radius: 8px;
        }

        .card-body {
            padding: 1.25rem !important;
        }

        .h2-md {
            font-size: 1.5rem;
        }

        .py-2 {
            padding-top: 0.5rem !important;
            padding-bottom: 0.5rem !important;
        }
    }

    @@media (min-width: 576px) {
        .h2-md {
            font-size: 1.75rem;
        }
    }

    @@media (max-width: 359px) {
        .tm-login-card {
            border-radius: 8px;
        }

        .card-body {
            padding: 1rem !important;
        }

        .fa-3x {
            font-size: 2rem;
        }

        .h2-md {
            font-size: 1.25rem;
        }

        .tm-form-control {
            font-size: 14px;
            padding: 0.65rem 0.75rem;
        }

        .btn-orange {
            min-height: 44px;
            font-size: 14px;
        }
    }

    @@media (hover: none) and (pointer: coarse) {
        .tm-form-control {
            font-size: 16px;
        }

        .btn-orange {
            min-height: 48px;
            font-size: 16px;
        }

        .tm-checkbox {
            width: 20px;
            height: 20px;
        }

        .tm-link-forgot:active,
        .tm-link-register:active {
            opacity: 0.8;
        }
    }

    @@media (max-height: 600px) {
        .tm-login-container {
            min-height: auto !important;
            padding: 0.75rem 0 !important;
        }

        .card-body {
            padding: 1.5rem !important;
        }

        .mb-4,
        .mb-md-4 {
            margin-bottom: 0.75rem !important;
        }

        .mb-5,
        .mb-md-5 {
            margin-bottom: 0.75rem !important;
        }

        .fa-3x {
            font-size: 2rem;
        }
    }

    @@media print {
        .tm-login-container {
            background: white;
            padding: 0;
        }

        .tm-login-card {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }

        .btn {
            display: none;
        }
    }
</style>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}