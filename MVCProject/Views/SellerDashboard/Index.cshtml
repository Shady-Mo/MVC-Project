@model MVCProject.ViewModels.SellerDashboardViewModels.SellerDashboardIndexVM

@{
    ViewData["Title"] = "My Dashboard";
    Layout = "_Layout";
}

<style>
    /* --- الحاوية الرئيسية اللي هتلم الشاشة وتعمل البادينج --- */
    .dashboard-wrapper {
        padding: 40px 5%; /* مسافة من فوق وتحت 40 بيكسل ومن الجوانب 5% */
        max-width: 1600px; /* أقصى عرض عشان الشاشات الكبيرة جداً */
        margin: 0 auto; /* توسيط في النص */
        animation: fadeIn 0.5s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

   

    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 35px; flex-wrap: wrap; gap: 15px; }
    .page-header h2 { font-size: 28px; font-weight: 700; color: #1a2a3a; margin: 0; }
    
    .stats-section { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-bottom: 40px; }
    .stat-card { background: white; padding: 25px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border-left: 5px solid #3ac0ad; transition: all 0.3s ease; }
    .stat-card:hover { transform: translateY(-5px); box-shadow: 0 8px 25px rgba(0,0,0,0.08); }
    .stat-card h4 { font-size: 13px; color: #888; margin: 0 0 12px 0; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .stat-card .number { font-size: 32px; font-weight: 800; color: #1a2a3a; margin: 0; }

    .tables-grid { display: flex; gap: 24px; flex-wrap: wrap; }
    
    .users-container { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); overflow: hidden; flex: 1; min-width: 320px; margin-bottom: 30px; transition: all 0.3s ease; }
    .users-container:hover { box-shadow: 0 8px 25px rgba(0,0,0,0.06); }
    
    .section-title { padding: 20px 24px; margin: 0; border-bottom: 1px solid #f0f0f0; font-size: 18px; color: #1a2a3a; font-weight: 700; display: flex; align-items: center; gap: 12px; background: #fafafa; }
    .section-title i { color: #3ac0ad; font-size: 20px; }

    /* Custom Scrollbar for tables */
    .table-responsive { overflow-x: auto; }
    .table-responsive::-webkit-scrollbar { height: 8px; }
    .table-responsive::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
    .table-responsive::-webkit-scrollbar-thumb { background: #c1c1c1; border-radius: 4px; }
    .table-responsive::-webkit-scrollbar-thumb:hover { background: #a8a8a8; }

    .users-table { width: 100%; margin: 0; border-collapse: collapse; }
    .users-table thead { background: linear-gradient(135deg, #1a2a3a 0%, #0f1923 100%); color: white; }
    .users-table thead th { padding: 16px 24px; font-weight: 600; font-size: 14px; text-align: left; border: none; letter-spacing: 0.5px; white-space: nowrap; }
    .users-table tbody tr { border-bottom: 1px solid #f0f0f0; transition: all 0.2s ease; }
    .users-table tbody tr:last-child { border-bottom: none; }
    .users-table tbody tr:hover { background: #f8fbfb; }
    .users-table tbody td { padding: 16px 24px; font-size: 14px; color: #444; vertical-align: middle; }
    .user-name { font-weight: 600; color: #1a2a3a; }
    
    .price-badge { background: rgba(40, 167, 69, 0.1); color: #28a745; display: inline-block; padding: 6px 14px; border-radius: 30px; font-size: 13px; font-weight: 700; border: 1px solid rgba(40, 167, 69, 0.2); }
    .empty-state { text-align: center; color: #888; padding: 30px !important; font-style: italic; }

    @@media (max-width: 768px) {
        .dashboard-wrapper { padding: 20px 15px; }
        .stats-section { grid-template-columns: 1fr; }
        .users-table thead th, .users-table tbody td { padding: 12px 15px; }
    }
</style>

<div class="dashboard-wrapper">
    <div class="page-header">
        <h2><i class="fas fa-store" style="margin-right: 10px; color: #3ac0ad;"></i> My Seller Dashboard</h2>
        <a href="@Url.Action("Statistics")" class="btn btn-success" style="padding: 10px 24px; border-radius: 8px; font-weight: 600; box-shadow: 0 4px 10px rgba(40, 167, 69, 0.2);">
            <i class="fas fa-chart-pie" style="margin-right: 8px;"></i> My Statistics
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-section">
        <div class="stat-card">
            <h4>My Accommodations</h4>
            <p class="number">@Model.TotalAccommodations</p>
        </div>
        <div class="stat-card" style="border-left-color: #f4b266;">
            <h4>My Flights</h4>
            <p class="number">@Model.TotalFlights</p>
        </div>
        <div class="stat-card" style="border-left-color: #dc3545;">
            <h4>My Activities</h4>
            <p class="number">@Model.TotalActivities</p>
        </div>
    </div>

    <div class="tables-grid">
        <!-- Recent Accommodations -->
        <div class="users-container">
            <h3 class="section-title"><i class="fas fa-hotel"></i> Recent Accommodations</h3>
            <div class="table-responsive">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.RecentAccommodations.Any())
                        {
                            foreach (var item in Model.RecentAccommodations)
                            {
                                <tr>
                                    <td class="user-name">@item.Name</td>
                                    <td><span class="price-badge">$@item.PricePerNight</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" class="empty-state">No accommodations added yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent Flights -->
        <div class="users-container">
            <h3 class="section-title"><i class="fas fa-plane-departure"></i> Recent Flights</h3>
            <div class="table-responsive">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>Destination</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.RecentFlights.Any())
                        {
                            foreach (var item in Model.RecentFlights)
                            {
                                <tr>
                                    <td class="user-name">@item.DestinationAirport</td>
                                    <td><span class="price-badge">$@item.Price</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" class="empty-state">No flights added yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent Activities -->
        <div class="users-container">
            <h3 class="section-title"><i class="fas fa-hiking"></i> Recent Activities</h3>
            <div class="table-responsive">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.RecentActivities.Any())
                        {
                            foreach (var item in Model.RecentActivities)
                            {
                                <tr>
                                    <td class="user-name">@item.Name</td>
                                    <td><span class="price-badge">$@item.Price</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" class="empty-state">No Activities added yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>