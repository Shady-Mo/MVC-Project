@model MVCProject.ViewModels.SellerDashboardViewModels.SellerStatisticsVM

@{
    ViewData["Title"] = "My Analytics";
    Layout = "_Layout";
}

<style>
    /* --- الحاوية الرئيسية --- */
    .dashboard-wrapper {
        padding: 40px 5%;
        max-width: 1600px;
        margin: 0 auto;
        animation: fadeIn 0.5s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .statistics-container { width: 100%; }
    .chart-card { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); padding: 30px; margin-bottom: 30px; border-top: 5px solid #3ac0ad; transition: all 0.3s ease; }
    .chart-card:hover { box-shadow: 0 8px 25px rgba(0,0,0,0.08); transform: translateY(-3px); }
    .chart-title { font-size: 18px; font-weight: 700; color: #1a2a3a; margin-bottom: 25px; display: flex; align-items: center; gap: 12px; }
    .chart-title i { color: #3ac0ad; font-size: 22px; }
    .chart-wrapper { position: relative; height: 320px; width: 100%; }
    .chart-wrapper.large { height: 380px; }
    
    .chart-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 30px; margin-bottom: 30px; }
    .chart-row.full { grid-template-columns: 1fr; }
    
    .statistics-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 35px; padding-bottom: 20px; border-bottom: 1px solid #e5e5e5; }
    .statistics-header h2 { font-size: 28px; font-weight: 700; color: #1a2a3a; margin: 0; display: flex; align-items: center; gap: 12px; }
    .statistics-header i { color: #3ac0ad; font-size: 28px; }
    
    .refresh-btn { padding: 12px 24px; background: linear-gradient(135deg, #3ac0ad 0%, #2aac99 100%); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; box-shadow: 0 4px 15px rgba(58,192,173,0.3); }
    .refresh-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(58,192,173,0.4); color: white; text-decoration: none; }
    
    .stats-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 35px; }
    .stat-mini-card { background: linear-gradient(135deg, #3ac0ad 0%, #2aac99 100%); color: white; padding: 25px 20px; border-radius: 12px; text-align: center; box-shadow: 0 4px 15px rgba(58,192,173,0.2); transition: all 0.3s ease; }
    .stat-mini-card:hover { transform: scale(1.02); box-shadow: 0 6px 20px rgba(58,192,173,0.3); }
    .stat-mini-card h4 { font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.9); margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 0.5px; }
    .stat-mini-card .value { font-size: 32px; font-weight: 800; color: white; margin: 0; }

    @@media (max-width: 1024px) {
        .dashboard-wrapper { padding: 20px 15px; }
        .chart-row { grid-template-columns: 1fr; }
        .chart-wrapper { height: 300px; }
        .statistics-header { flex-direction: column; align-items: flex-start; gap: 20px; }
        .refresh-btn { width: 100%; justify-content: center; }
    }
</style>

<div class="dashboard-wrapper">
    <div class="statistics-container">
        <div class="statistics-header">
            <h2>
                <i class="fas fa-chart-line"></i> My Analytics
            </h2>
            <a href="@Url.Action("Statistics")" class="refresh-btn">
                <i class="fas fa-sync-alt"></i> Refresh Data
            </a>
        </div>

        <!-- Summary Stats -->
        <div class="stats-summary">
            <div class="stat-mini-card">
                <h4>My Total Revenue</h4>
                <div class="value">$@Model.RevenueOverview.Revenue.Sum().ToString("F0")</div>
            </div>
            <div class="stat-mini-card">
                <h4>Total Bookings</h4>
                <div class="value">@(Model.BookingStatusBreakdown.Counts.Sum())</div>
            </div>
            <div class="stat-mini-card">
                <h4>Confirmed Bookings</h4>
                <div class="value">@Model.BookingStatusBreakdown.Counts.ElementAtOrDefault(1)</div>
            </div>
        </div>

        <!-- Charts Row 1: Full width Line Chart for Revenue -->
        <div class="chart-row full">
            <div class="chart-card">
                <div class="chart-title">
                    <i class="fas fa-chart-area"></i> My Revenue Overview (Last 6 Months)
                </div>
                <div class="chart-wrapper large">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Charts Row 2: Pie and Doughnut -->
        <div class="chart-row">
            <!-- Service Distribution Chart -->
            <div class="chart-card">
                <div class="chart-title">
                    <i class="fas fa-chart-pie"></i> My Service Distribution
                </div>
                <div class="chart-wrapper">
                    <canvas id="serviceChart"></canvas>
                </div>
            </div>

            <!-- Booking Status Chart -->
            <div class="chart-card">
                <div class="chart-title">
                    <i class="fas fa-circle-notch"></i> My Booking Status Breakdown
                </div>
                <div class="chart-wrapper">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const chartConfig = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    labels: { usePointStyle: true, padding: 20, font: { size: 13, weight: '600', family: "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif" }, color: '#555' }
                }
            }
        };

        // 1. Revenue Chart - Line Chart
        const revenueCtx = document.getElementById('revenueChart').getContext('2d');
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueOverview.Months)),
                datasets: [{
                    label: 'Monthly Revenue ($)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueOverview.Revenue)),
                    borderColor: '#3ac0ad', backgroundColor: 'rgba(58, 192, 173, 0.15)', borderWidth: 3, fill: true,
                    tension: 0.4, pointRadius: 5, pointBackgroundColor: '#3ac0ad', pointBorderColor: '#fff', pointBorderWidth: 2, pointHoverRadius: 7
                }]
            },
            options: {
                ...chartConfig,
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(0, 0, 0, 0.04)', drawBorder: false }, ticks: { color: '#888', font: { size: 12 }, padding: 10 } },
                    x: { grid: { display: false, drawBorder: false }, ticks: { color: '#888', font: { size: 12 }, padding: 10 } }
                }
            }
        });

        // 2. Service Distribution - Pie Chart
        const serviceCtx = document.getElementById('serviceChart').getContext('2d');
        new Chart(serviceCtx, {
            type: 'pie',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ServiceDistribution.Services)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ServiceDistribution.Counts)),
                    backgroundColor: ['#3ac0ad', '#f4b266', '#dc3545'],
                    borderColor: 'white', borderWidth: 3, hoverOffset: 4
                }]
            },
            options: chartConfig
        });

        // 3. Booking Status - Doughnut Chart
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BookingStatusBreakdown.Statuses)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BookingStatusBreakdown.Counts)),
                    backgroundColor: ['#f4b266', '#3ac0ad', '#dc3545'],
                    borderColor: 'white', borderWidth: 3, hoverOffset: 4
                }]
            },
            options: {
                ...chartConfig,
                cutout: '65%' // عشان يبقى شكل الـ Doughnut أنحف وأشيك
            }
        });
    </script>
}